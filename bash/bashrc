# bash, for the odd interactive bash session: zsh is the login shell, and scripts don't read
# this. Linked to ~/.bashrc, and on macOS to ~/.bash_profile too.
case $- in
*i*) ;;
*) return ;;
esac

# History: no duplicates or lines starting with a space; append rather than overwrite
HISTSIZE=1000
HISTFILESIZE=2000
HISTCONTROL=ignoreboth
HISTIGNORE='ls:bg:fg:history:hh'
shopt -s histappend

PS1='\[\e[0;32m\]\u\[\e[m\]:\[\e[1;34m\]\W\[\e[m\]$ '

# Shared with zsh
source ~/dotfiles/bash/bash_shortcuts.sh
source ~/dotfiles/bash/bash_preferences.sh
