#!/usr/bin/env bash
# Symlinks this repo's configs into $HOME. Safe to re-run (see link in setup/lib.sh).
set -euo pipefail
# shellcheck source=../setup/lib.sh
. "$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)/setup/lib.sh"

link bash/bashrc "$HOME/.bashrc"
if is_mac; then link bash/bashrc "$HOME/.bash_profile"; fi
link bash/zshrc "$HOME/.zshrc"
link bash/zshenv "$HOME/.zshenv"
link bash/inputrc "$HOME/.inputrc"
link vim "$CONFIG/nvim"
link vim/vsnip "$HOME/.vsnip"
link tmux/tmux.conf "$HOME/.tmux.conf"
link ghostty/config.ghostty "$CONFIG/ghostty/config.ghostty"
link elixir/.iex.exs "$HOME/.iex.exs"
link mise/dotfiles.toml "$CONFIG/mise/conf.d/dotfiles.toml"
link atuin/config.toml "$CONFIG/atuin/config.toml"

# Shared SSH defaults (ssh/config), included at the end of ~/.ssh/config so that the host
# entries above them win. ~/.ssh/config itself stays local.
mkdir -p "$HOME/.ssh/control"
chmod 700 "$HOME/.ssh" "$HOME/.ssh/control"
if ! grep -qsF "Include \"$DOTFILES/ssh/config\"" "$HOME/.ssh/config"; then
  printf '\n# Shared defaults from the dotfiles; keep this at the end\nMatch all\nInclude "%s"\n' \
    "$DOTFILES/ssh/config" >>"$HOME/.ssh/config"
  chmod 600 "$HOME/.ssh/config"
  echo "added the shared defaults to ~/.ssh/config"
fi

# Ghostty's terminfo (ghostty/xterm-ghostty.terminfo), so TERM=xterm-ghostty works here after
# a plain `ssh` from Ghostty. Compiled into ~/.terminfo when missing or after the file changes;
# tic's usual warning about the description field is kept quiet unless it fails.
# After a Ghostty upgrade, on the laptop: infocmp -x xterm-ghostty > ghostty/xterm-ghostty.terminfo
terminfo="$DOTFILES/ghostty/xterm-ghostty.terminfo"
compiled="$(find "$HOME/.terminfo" -name xterm-ghostty 2>/dev/null | head -1 || true)"
if have tic && { [ -z "$compiled" ] || [ "$terminfo" -nt "$compiled" ]; }; then
  if out="$(tic -x -o "$HOME/.terminfo" "$terminfo" 2>&1)"; then
    echo "compiled terminfo: xterm-ghostty"
  else
    echo "tic failed on $terminfo: $out" >&2
  fi
fi
