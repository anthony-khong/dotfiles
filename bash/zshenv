# Read by every zsh, including the non-interactive ones that `ssh host cmd` and mosh start
# (mosh launches mosh-server that way). Keep it small; interactive setup lives in zshrc.
for dir in /opt/homebrew/bin "$HOME/.cargo/bin" "$HOME/.local/share/mise/shims"; do
  if [ -d "$dir" ]; then export PATH="$dir:$PATH"; fi
done
unset dir

# dotfiles-update reminds about oh-my-zsh along with everything else (bash_preferences.sh);
# this has to be set before zshrc loads oh-my-zsh
zstyle ':omz:update' mode disabled
