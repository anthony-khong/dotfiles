keybind = super+bracket_right=goto_split:next
keybind = ctrl+super+==unbind
keybind = ctrl+super+equal=equalize_splits
keybind = super+f=unbind
keybind = super+key_f=start_search
keybind = super+e=unbind
keybind = super+key_e=search_selection
keybind = shift+super+f=unbind
keybind = shift+super+key_f=end_search
