# Ghostty's default Cmd shortcuts, bound to key positions instead of letters.
# With the "Dvorak - QWERTY ⌘" layout, Ghostty 1.3 reads Cmd shortcuts by their Dvorak letter
# for some keys (Cmd-, and Cmd-W come out swapped), unlike every other Mac app: ghostty-org/ghostty#7315.
# Each default is unbound, then rebound to where its letter sits on QWERTY.
# Included by config.ghostty; delete this file and that include once Ghostty is fixed.
# Generated from Ghostty 1.3.1's defaults (src/config/Config.zig).
keybind = shift+super+,=unbind
keybind = shift+super+comma=reload_config
keybind = super+,=unbind
keybind = super+comma=open_config
keybind = super+c=unbind
keybind = performable:super+key_c=copy_to_clipboard:mixed
keybind = super+v=unbind
keybind = super+key_v=paste_from_clipboard
keybind = super+==unbind
keybind = super+equal=increase_font_size:1
keybind = super+-=unbind
keybind = super+minus=decrease_font_size:1
keybind = ctrl+shift+super+j=unbind
keybind = ctrl+shift+super+key_j=write_screen_file:copy
keybind = shift+super+j=unbind
keybind = shift+super+key_j=write_screen_file:paste
keybind = alt+shift+super+j=unbind
keybind = alt+shift+super+key_j=write_screen_file:open
keybind = ctrl+super+[=unbind
keybind = ctrl+super+bracket_left=goto_split:previous
keybind = ctrl+super+]=unbind
keybind = ctrl+super+bracket_right=goto_split:next
keybind = shift+super+p=unbind
keybind = shift+super+key_p=toggle_command_palette
keybind = super+q=unbind
keybind = super+key_q=quit
keybind = super+k=unbind
keybind = performable:super+key_k=clear_screen
keybind = super+a=unbind
keybind = super+key_a=select_all
keybind = shift+super+t=unbind
keybind = performable:shift+super+key_t=undo
keybind = super+z=unbind
keybind = performable:super+key_z=undo
keybind = shift+super+z=unbind
keybind = performable:shift+super+key_z=redo
keybind = super+j=unbind
keybind = super+key_j=scroll_to_selection
keybind = super+n=unbind
keybind = super+key_n=new_window
keybind = super+w=unbind
keybind = super+key_w=close_surface
keybind = alt+super+w=unbind
keybind = alt+super+key_w=close_tab:this
keybind = shift+super+w=unbind
keybind = shift+super+key_w=close_window
keybind = alt+shift+super+w=unbind
keybind = alt+shift+super+key_w=close_all_windows
keybind = super+t=unbind
keybind = super+key_t=new_tab
keybind = shift+super+[=unbind
keybind = shift+super+bracket_left=previous_tab
