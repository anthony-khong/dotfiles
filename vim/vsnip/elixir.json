{
  "latu-aliases": {
    "prefix": "LT",
    "body": [
      "import Latu.Column",
      "alias Latu.Functions, as: F",
      "alias Latu.Window, as: W"
    ]
  },
  "latu-connect": {
    "prefix": "Lconn",
    "body": [
      "{:ok, session} = Latu.connect(\"sc://localhost:${1:15002}\")"
    ]
  },
  "latu-read": {
    "prefix": "Lread",
    "body": [
      "Latu.read(session, format: \"${1:parquet}\", path: \"${2:/data/x.parquet}\")"
    ]
  },
  "latu-table": {"prefix": "Ltable", "body": ["Latu.table(session, \"${1:name}\")"]},
  "latu-sql": {
    "prefix": "Lsql",
    "body": [
      "{:ok, ${1:df}} = Latu.sql(session, \"${2:SELECT * FROM t}\")"
    ]
  },
  "latu-range": {"prefix": "Lrange", "body": ["Latu.range(session, ${1:10})"]},
  "latu-create-dataframe": {
    "prefix": "Lcdf",
    "body": [
      "Latu.create_dataframe!(session, [",
      "  %{${1:id}: ${2:1}}",
      "], schema: \"${3:id INT}\")"
    ]
  },

  "pipe-to-agg": {
    "prefix": ">La",
    "body": [
      "|> Latu.agg(${1:total}: F.${2:sum}(${3::column}))"
    ]
  },
  "pipe-to-collect": {"prefix": ">Lc", "body": ["|> Latu.collect!()"]},
  "pipe-to-cache": {"prefix": ">Lcache", "body": ["|> Latu.cache!()"]},
  "pipe-to-checkpoint": {
    "prefix": ">Lcheck",
    "body": [
      "|> Latu.checkpoint!(local: ${1:true})"
    ]
  },
  "pipe-to-distinct": {"prefix": ">Ldist", "body": ["|> Latu.distinct()"]},
  "pipe-to-drop": {"prefix": ">Ldr", "body": ["|> Latu.drop([${1::column}])"]},
  "pipe-to-explain": {
    "prefix": ">Le",
    "body": [
      "|> Latu.explain!(mode: ${1::formatted})"
    ]
  },
  "pipe-to-filter": {"prefix": ">Lf", "body": ["|> Latu.filter(${1:predicate})"]},
  "pipe-to-group-by": {"prefix": ">Lg", "body": ["|> Latu.group_by([${1::column}])"]},
  "pipe-to-head": {"prefix": ">Lh", "body": ["|> Latu.head!(${1:5})"]},
  "pipe-to-join": {
    "prefix": ">Lj",
    "body": [
      "|> Latu.join(${1:df}, how: ${2::inner}, on: [${3::column}])"
    ]
  },
  "pipe-to-limit": {"prefix": ">Ll", "body": ["|> Latu.limit(${1:10})"]},
  "pipe-to-count": {"prefix": ">Ln", "body": ["|> Latu.count!()"]},
  "pipe-to-sort": {"prefix": ">Lo", "body": ["|> Latu.sort(desc(${1::column}))"]},
  "pipe-to-observe": {
    "prefix": ">Lob",
    "body": [
      "|> Latu.observe(${1::name}, ${2:count}: F.count(lit(1)))"
    ]
  },
  "pipe-to-persist": {
    "prefix": ">Lpersist",
    "body": [
      "|> Latu.persist!(level: ${1::disk_only})"
    ]
  },
  "pipe-to-print-schema": {"prefix": ">Lps", "body": ["|> Latu.print_schema!()"]},
  "pipe-to-rename": {"prefix": ">Lr", "body": ["|> Latu.rename(${1:from}: ${2::to})"]},
  "pipe-to-select": {"prefix": ">Ls", "body": ["|> Latu.select([${1::column}])"]},
  "pipe-to-show": {"prefix": ">Lsh", "body": ["|> Latu.show!()"]},
  "pipe-to-write": {
    "prefix": ">Lw",
    "body": [
      "|> Latu.write!(format: \"${1:parquet}\", path: \"${2:/data/out}\", mode: ${3::overwrite})"
    ]
  },
  "pipe-to-with-columns": {
    "prefix": ">Lwc",
    "body": [
      "|> Latu.with_columns(${1:name}: ${2:expr})"
    ]
  },
  "pipe-to-explorer": {"prefix": ">Lx", "body": ["|> Latu.to_explorer!()"]},
  "latu-progress-handler": {
    "prefix": "Lprog",
    "body": [
      "progress: fn p -> IO.write(\"\\r#{Latu.Progress.percent(p)}%\") end"
    ]
  },
  "latu-over-window": {
    "prefix": "Lover",
    "body": [
      "over(F.${1:rank}(), W.partition_by([${2::column}]) |> W.order_by([desc(${3::column})]))"
    ]
  },
  "latu-when-otherwise": {
    "prefix": "Lwhen",
    "body": [
      "when_(${1:condition}, ${2:value}) |> otherwise(${3:else_value})"
    ]
  },
  "latu-expr": {"prefix": "Lexpr", "body": ["expr(\"${1:a > 1 AND b <> 'x'}\")"]},
  "latu-fun-escape-hatch": {
    "prefix": "Lfun",
    "body": [
      "fun(\"${1:function_name}\", [${2:args}])"
    ]
  },
  "latu-checkpoint-bracket": {
    "prefix": "Lcheck",
    "body": [
      "Latu.with_checkpoint!(${1:df}, fn ${2:cp} ->",
      "  ${0}",
      "end)"
    ]
  }
  "pipe-to-dataframe-print": {
    "prefix": ">Dp",
    "body": "|> DF.print(limit: :infinity)"
  },
  "pipe-to-dataframe-arrange": {
    "prefix": ">Da",
    "body": "|> DF.arrange(desc: ${1:column})"
  },
  "pipe-to-dataframe-mutate": {
    "prefix": ">Dm",
    "body": "|> DF.mutate(${1:mutation})"
  },
  "pipe-to-dataframe-select": {
    "prefix": ">Dsel",
    "body": "|> DF.select([${1:column}])"
  },
  "pipe-to-dataframe-summarise": {
    "prefix": ">Dsum",
    "body": "|> DF.summarise(${1:query})"
  },
  "pipe-to-dataframe-filter": {
    "prefix": ">Df",
    "body": "|> DF.filter(${1:query})"
  },
  "pipe-to-dataframe-group-by": {
    "prefix": ">Dg",
    "body": "|> DF.group_by([${1:column}])"
  },
  "pipe-to-dataframe-join": {
    "prefix": ">Dj",
    "body": "|> DF.join(${1:df}, how: ${2::inner}, on: [${3:column}])"
  },
  "pipe-to-floki-parse-document": {
    "prefix": ">Flp",
    "body": "|> Floki.parse_document!()"
  },
  "pipe-to-floki-text": {
    "prefix": ">Flt",
    "body": "|> Floki.text()"
  },
  "pipe-to-floki-find": {
    "prefix": ">Flf",
    "body": "|> Floki.find(${1:selector})"
  },
  "pipe-to-floki-attribute": {
    "prefix": ">Fla",
    "body": "|> Floki.attribute(${1:selector}, ${2:attr})"
  },
  "rustler-apple-silicon-target": {
    "prefix": "RAS",
    "body": "target: \"aarch64-apple-darwin\","
  },
  "use-genserver": {
    "prefix": "genserver",
    "body": [
      "use GenServer",
      "",
      "@doc false",
      "def start_link(init_args) do",
      "  GenServer.start_link(__MODULE__, init_args, name: __MODULE__)",
      "end",
      "",
      "@impl true",
      "def init(state) do",
      "  {:ok, state}",
      "end"
    ]
  },
  "pipe-vega-lite-show": {
    "prefix": ">vs",
    "body": "|> VegaLite.Viewer.show()"
  },
  "pipe-vega-lite": {
    "prefix": ">v",
    "body": "|> Vl.${1:function}"
  },
  "pipe-to-random": {
    "prefix": ">r",
    "body": "|> Enum.random()"
  },
  "pipe-to-first": {
    "prefix": ">1",
    "body": "|> List.first()"
  },
  "pipe-to-last": {
    "prefix": ">-1",
    "body": "|> List.last()"
  },
  "pipe-to-nth": {
    "prefix": ">nth",
    "body": "|> Enum.at(${0})"
  },
  "pipe-to-list": {
    "prefix": ">l",
    "body": "|> Enum.to_list()"
  },
  "pipe-to-async-stream": {
    "prefix": ">a",
    "body": "|> Task.async_stream(fn ${1} -> ${0} end)"
  },
  "pipe-flow-map": {
    "prefix": ">Fm",
    "body": "|> Flow.map(fn ${1} -> ${0} end)"
  },
  "pipe-flow-filter": {
    "prefix": ">Ff",
    "body": "|> Flow.filter(fn ${1} -> ${0} end)"
  },
  "pipe-flow": {
    "prefix": ">F",
    "body": [
       "|> Flow.from_enumerable()",
       "|> Flow.partition(max_demand: ${1:max_demand}, stages: ${2:stages})"
    ]
  },
  "def-module": {
    "prefix": "defmo",
    "body": [
      "defmodule ${1:${VIM:substitute(substitute(expand('%:t:r'),'\\(\\%(\\<\\l\\+\\)\\%(_\\)\\@=\\)\\|_\\(\\l\\)','\\u\\1\\2','g'),'\\<.','\\u&','g')}} do",
      "  ${2:body}",
      "end"
    ]
  },
  "empty-map": {
    "prefix": "m",
    "body": [
      "%{\"${1:${VISUAL:key}}\" => ${2:value}}"
    ]
  },
  "heex-template": {
    "prefix": "heex",
    "body": [
      "~H\"\"\"",
      "${2:body}",
      "\"\"\""
    ]
  },
  "handle-info": {
    "prefix": "info",
    "body": [
      "def handle_info(${1:${VISUAL:event}}, state) do",
      "  {:noreply, state}",
      "end"
    ]
  },
  "liveview-function-component": {
    "prefix": "fcomp",
    "body": [
      "def ${1:${VISUAL:component_name}}(assigns) do",
      "  ~H\"\"\"",
      "  ${2:body}",
      "  \"\"\"",
      "end"
    ]
  },
  "live-component-markup": {
    "prefix": "lv",
    "body": [
      "<.live_component module={${1:${VISUAL:module}}} id={${2:id}} />"
    ]
  },
  "live-component-update": {
    "prefix": "cupdate",
    "body": [
      "def update(assigns, socket) do",
      "  {:ok, assign(socket, ${1:${VISUAL:assigns}})}",
      "end"
    ]
  },
  "live-component-mount": {
    "prefix": "cmount",
    "body": [
      "def mount(socket) do",
      "  {:ok, assign(socket, ${1:${VISUAL:assigns}})}",
      "end"
    ]
  },
  "liveview-mount": {
    "prefix": "mount",
    "body": [
      "def mount(params, session, socket) do",
      "  {:ok, assign(socket, ${1:${VISUAL:assigns}})}",
      "end"
    ]
  },
  "liveview-handle-params": {
    "prefix": "params",
    "body": [
      "def handle_params(params, uri, socket) do",
      "  {:noreply, socket}",
      "end"
    ]
  },
  "liveview-render": {
    "prefix": "render",
    "body": [
      "def render(assigns) do",
      "  ~H\"\"\"",
      "  ${1:${VISUAL:template}}",
      "  \"\"\"",
      "end"
    ]
  },
  "liveview-event": {
    "prefix": "event",
    "body": [
      "def handle_event(${1:${VISUAL:event}}, data, socket) do",
      "  {:noreply, assign(socket)}",
      "end"
    ]
  },
  "pipe->": {
    "prefix": ">",
    "body": "|> $0"
  },
  "pipe-each": {
    "prefix": ">e",
    "body": "|> Enum.each(fn ${1} -> ${0} end)"
  },
  "pipe-map": {
    "prefix": ">m",
    "body": "|> Enum.map(fn ${1} -> ${0} end)"
  },
  "pipe-flat-map": {
    "prefix": ">fm",
    "body": "|> Enum.flat_map(fn ${1} -> ${0} end)"
  },
  "pipe-map-point-free": {
    "prefix": ">mpf",
    "body": "|> Enum.map(&${0})"
  },
  "pipe-map-anon": {
    "prefix": ">ma",
    "body": "|> Enum.map(&(${0}))"
  },
  "pipe-filter": {
    "prefix": ">f",
    "body": "|> Enum.filter(fn ${1} -> ${0} end)"
  },
  "pipe-inspect": {
    "prefix": ">i",
    "body": "|> IO.inspect()"
  },
  "pipe-inspect-label": {
    "prefix": ">il",
    "body": "|> IO.inspect(label: \"${1:label}\")"
  },
  "word-list": {
    "prefix": "wl",
    "body": "~w(${0})"
  },
  "atom-list": {
    "prefix": "al",
    "body": "~w(${0})a"
  },
  "inspect": {
    "prefix": "ins",
    "body": "IO.inspect($0)"
  },
  "implementation": {
    "prefix": "impl",
    "body": [
      "@impl true",
      "def ${1:name} do",
      "  ${0}",
      "end"
    ]
  },
  "require-explorer-dataframe": {
    "prefix": "DF",
    "body": "require Explorer.DataFrame, as: DF"
  },
  "alias-explorer-series": {
    "prefix": "S",
    "body": "alias Explorer.Series, as: Series"
  },
  "ash-actions": {
    "prefix": "act",
    "body": ["actions do", "  $0", "end"]
  },
  "ash-attributes": {
    "prefix": "attrs",
    "body": ["attributes do", "  $0", "end"]
  },
  "ash-attribute": {
    "prefix": "attr",
    "body": "attribute ${1:field}, ${2::type}"
  },
  "ash-relationships": {
    "prefix": "rel",
    "body": ["relationships do", "  $0", "end"]
  },
  "ash-resource": {
    "prefix": "ashr",
    "body": "use Ash.Resource, data_layer: AshPostgres.DataLayer"
  },
  "recompile": {
    "prefix": "rec",
    "body": ["recompile()"]
  },
  "section-break": {
    "prefix": "sb",
    "body": [
      "# =============================================",
      "# ${1:${VISUAL:Section}}",
      "# ============================================="
    ]
  }
}
